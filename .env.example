# ============================================================================
# .env.example — BOOTSTRAP TECHNIQUE UNIQUEMENT.
#
# Le .env ne contient PLUS aucune configuration métier. Toute la config métier
# vit en base et se configure via les panels Dev :
#   - Stripe institut/dev & Brevo (clés) → Dev Panel → API intégrée (IntegratedAPI)
#       migration : node scripts/migrateEnvCredentialsToIntegratedApi.js --apply
#   - Expéditeurs e-mail                  → Dev/Manager Panel → Communication Identity
#   - Institut, adresse, fiscalité, domaines → Dev Panel → Paramètres Système
#       seed initial : node scripts/seedSystemConfiguration.js
# ============================================================================

# --- Strictement obligatoires (le process NE DÉMARRE PAS sans elles) --------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
# Générer un secret : node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=<base64-session-secret>
PWD_PEPPER=<base64-pepper>
# Clé racine du coffre IntegratedAPI — 64 hex (32 octets) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBLIGATOIRE partout (politique UNIFORME, identique dev/prod) : le backend refuse de
# démarrer sans elle. Tests : clé injectée ; dev : clé locale ; prod : clé de production.
CREDENTIAL_VAULT_KEY=<64-hex-vault-key>

# --- Optionnels techniques (défaut sûr si absents) --------------------------
# PORT=4000                       # défaut 3000
# NODE_ENV=development
# TZ=Europe/Paris                 # forcé au boot hors test (garde timezone)
#
# DOMAINES : plus aucune variable d'environnement (ni NGROK_DOMAIN ni APP_BASE_URL).
# Configure URL vitrine + URL panel dans Dev Panel → Paramètres Système (ngrok inclus).
# Tant qu'aucun domaine n'est configuré, le DomainResolver utilise http://localhost:3000.

# --- Coffre : fallback & rotation -------------------------------------------
# Fallback .env des credentials : opt-in EXPLICITE, identique dans tous les environnements.
# ALLOW_ENV_CREDENTIAL_FALLBACK=false
# Rotation de la clé du coffre (scripts/rotateCredentialVaultKey.js) — seulement pendant une rotation.
# OLD_CREDENTIAL_VAULT_KEY=
# NEW_CREDENTIAL_VAULT_KEY=

# --- Secrets optionnels -----------------------------------------------------
# Signature des liens de vérification e-mail (fallback : SESSION_SECRET).
# EMAIL_VERIFICATION_SECRET=
# Secret webhook Brevo — OBLIGATOIRE en production (sinon /api/webhooks/brevo → 503).
# Seedé au coffre (brevo/webhook_secret). Ne jamais logguer.
# BREVO_WEBHOOK_SECRET=

# --- Flags runtime (tous avec défaut sûr) -----------------------------------
# CHECKOUT_HOSTED=false                    # U2 — Stripe Checkout hébergé
# PLATFORM_CHECKOUT_HOSTED=false           # U3 — Checkout plateforme (Stripe Dev)
# CHECKOUT_RETURN_BASE_URL=                # R2C — base React du retour Checkout
# MAIL_ROLE_RESOLVER_ENABLED=false         # M2 — moteur d'envoi par rôles
# NOTIFICATION_TEMPLATE_RUNTIME_ENABLED=true  # M8 — templates notif runtime
# EVENT_NOTIFICATION_SUBSCRIBER_MODE=off   # off|shadow|active (Phase 4D/4E)
# ENABLE_EVENT_NOTIFICATION_SUBSCRIBERS=false  # alias legacy de la var ci-dessus
# REACT_OFFICIAL_FRONTEND=false            # RX1 — React = frontend officiel (ON) vs Vanilla (OFF)
