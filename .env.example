PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
PWD_PEPPER=<base64-pepper>
SESSION_SECRET=<base64-session-secret>
APP_BASE_URL=https://example.ngrok-free.app

NGROK_DOMAIN=example.ngrok-free.app

# ---------------------------------------------------------------------------
# Credential vault (IntegratedApi) — Phase 1
# CREDENTIAL_VAULT_KEY : 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the app refuses to boot if this key is missing/invalid.
CREDENTIAL_VAULT_KEY=
# Temporary migration flag: when 'true', credential reads fall back to the LEGACY
# .env vars below if the vault has no value. MUST be 'false' in production once the
# vault is seeded (otherwise a vault miss silently reads .env).
ALLOW_ENV_CREDENTIAL_FALLBACK=false

# Vault key rotation (scripts/rotateCredentialVaultKey.js). Only needed during a
# rotation — not for normal boot. Set BOTH, run a dry-run first, then with --apply:
#   OLD_CREDENTIAL_VAULT_KEY=<current> NEW_CREDENTIAL_VAULT_KEY=<new> \
#     node scripts/rotateCredentialVaultKey.js          # dry-run
#   ... node scripts/rotateCredentialVaultKey.js --apply
# After --apply succeeds, set CREDENTIAL_VAULT_KEY = the NEW key and restart.
OLD_CREDENTIAL_VAULT_KEY=
NEW_CREDENTIAL_VAULT_KEY=

# EventBus -> Notification subscribers (Phase 4D/4E). Mode controls the subscriber
# that turns business events (sale.finalized, booking.no_show_marked) into in-app
# notifications (idempotent, NO email):
#   off    : disabled (default — simple rollback).
#   shadow : process events + record NotificationEventDelivery(status=shadow) but
#            create NO Notification (parity validation before going live).
#   active : create the Notification (a prior shadow delivery is upgraded).
EVENT_NOTIFICATION_SUBSCRIBER_MODE=off
# Legacy alias (kept for compatibility): ENABLE_EVENT_NOTIFICATION_SUBSCRIBERS=true
# is equivalent to EVENT_NOTIFICATION_SUBSCRIBER_MODE=active. Prefer the mode var.
ENABLE_EVENT_NOTIFICATION_SUBSCRIBERS=false

# --- LEGACY / fallback migration ---------------------------------------------
# The Stripe/Brevo secrets below are now sourced from the credential vault
# (slugs: stripe-institut, stripe-dev, brevo). They are kept ONLY as a temporary
# fallback while ALLOW_ENV_CREDENTIAL_FALLBACK=true. Remove once the vault is
# seeded and the fallback is disabled.
STRIPE_SECRET_KEY=sk_test_xxx           # LEGACY -> vault stripe-institut/secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_xxx      # LEGACY -> vault stripe-institut/publishable_key
STRIPE_WEBHOOK_SECRET=whsec_xxx         # LEGACY -> vault stripe-institut/webhook_secret

# Compte Stripe Developer (frais de lancement + mensualités)
STRIPE_DEV_SECRET_KEY=sk_test_xxx       # LEGACY -> vault stripe-dev/secret_key
STRIPE_DEV_PUBLISHABLE_KEY=pk_test_xxx  # LEGACY -> vault stripe-dev/publishable_key
STRIPE_DEV_WEBHOOK_SECRET=whsec_xxx     # LEGACY -> vault stripe-dev/webhook_secret

BREVO_API_KEY=<brevo-api-key>           # LEGACY -> vault brevo/api_key
# Sprint pré-React A3 — secret partagé du webhook Brevo (header x-brevo-secret ou
# ?secret=). OPTIONNEL en dev/test, OBLIGATOIRE en production : sans lui le webhook
# /api/webhooks/brevo répond 503 (endpoint désactivé). Seedé au coffre (brevo/
# webhook_secret) seulement si défini ici. Ne jamais logguer cette valeur.
BREVO_WEBHOOK_SECRET=                    # -> vault brevo/webhook_secret (obligatoire en prod)
MAIL_FROM=contact@example.com
MAIL_FROM_NAME=Beauty Savage

INSTITUTE_NAME=Beauty Savage
INVOICE_CONTACT_EMAIL=contact@example.com
INSTITUTE_ADDRESS_LINE1=1 Rue de la Formation
INSTITUTE_CITY=Paris
INSTITUTE_POSTAL_CODE=75001
INSTITUTE_COUNTRY=FR
INSTITUTE_SIRET=123 456 789 00001
INSTITUTE_VAT_MENTION=TVA non applicable, article 293B du CGI

# ---------------------------------------------------------------------------
# Fuseau métier (Sprint pré-React A2)
# Les calculs calendrier (créneaux prestations, sessions formation) sont en HEURE
# MURALE LOCALE du serveur. L'app force TZ=Europe/Paris au démarrage (hors test) via
# la garde constants/timezone.js. En production, posez explicitement TZ pour garantir
# l'alignement quel que soit l'hôte (UTC, cloud, etc.).
TZ=Europe/Paris

# Sprint U2 — Stripe Checkout hébergé (false = Stripe Elements actuel ; true = Checkout hébergé)
CHECKOUT_HOSTED=false
# Sprint U3 — Checkout hébergé PLATEFORME Stripe Dev (false = anciens flows inchangés)
PLATFORM_CHECKOUT_HOSTED=false
# Sprint R2C — Base URL React pour le retour du Checkout hébergé (success/cancel).
# Vide = retour Vanilla inchangé. Si http(s) absolue → retour vers /paiement/succes|annule React.
CHECKOUT_RETURN_BASE_URL=
# Sprint M2 — Moteur d'envoi e-mail par rôles (fromRole/toRole). false = envois existants inchangés ;
# true = le subscriber M2 dispatche (en shadow tant qu'un envoi direct existe pour l'event).
MAIL_ROLE_RESOLVER_ENABLED=false
